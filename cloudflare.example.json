{
  "name": "commonplace-journal",
  "account_id": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "commonplace",
      "database_id": "REPLACE_WITH_D1_DATABASE_UUID"
    }
  ],
  "vars": {
    "SITE_URL": "https://journal.your-domain.com",
    "ADMIN_EMAILS": "owner@your-domain.com",
    "ACCESS_TEAM_DOMAIN": "https://YOUR-TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUDIENCE",
    "TURNSTILE_SITE_KEY": "REPLACE_WITH_REAL_TURNSTILE_WIDGET_SITE_KEY"
  }
}
